{
  "version": 2,
  "levels": {
    "reporting": ["C4"],
    "adopted": ["C4", "C2", "C8", "C9"]
  },
  "checks": [
    {
      "id": "C8",
      "title": "AGENTS.md names the standard version",
      "severity": "required",
      "since": "v2.0.0",
      "required_from": "2026-12-13",
      "kind": "contains",
      "path": "AGENTS.md",
      "pattern": "\\*\\*Standard:\\*\\* pmo-project-standardization v\\d+\\.\\d+\\.\\d+",
      "fix": "Put the repo on the standard: /new-project, option 3 (adds AGENTS.md with the Standard line)."
    },
    {
      "id": "C2",
      "title": "AGENTS.md has the Hosting line",
      "severity": "required",
      "since": "v1.0.0",
      "required_from": "2026-11-09",
      "kind": "contains",
      "path": "AGENTS.md",
      "pattern": "\\*\\*Hosting: (local|github)\\*\\*",
      "fix": "Add '**Hosting: local**' or '**Hosting: github**' under the Standard line in AGENTS.md."
    },
    {
      "id": "C9",
      "title": "The project docs exist: requirements, decisions, session log",
      "severity": "required",
      "since": "v2.0.0",
      "required_from": "2026-12-13",
      "kind": "exists",
      "paths": [
        "docs/requirements.md",
        "docs/decisions.md",
        "docs/session-log.md"
      ],
      "fix": "Copy the missing files from the template's scaffold/docs/."
    },
    {
      "id": "C4",
      "title": "portfolio.json exists and fits the schema",
      "severity": "required",
      "since": "v1.3.0",
      "required_from": "2026-11-24",
      "kind": "schema",
      "path": "portfolio.json",
      "schema": "portfolio.schema.json",
      "fix": "Add portfolio.json (/new-project, option 4, or copy scaffold/portfolio.json), fill in name, owner and program, then run /report."
    },
    {
      "id": "C10",
      "title": "On standard v2",
      "severity": "required",
      "since": "v2.0.0",
      "required_from": "2026-12-13",
      "kind": "contains",
      "path": "AGENTS.md",
      "pattern": "\\*\\*Standard:\\*\\* pmo-project-standardization v2\\.\\d+\\.\\d+",
      "fix": "Move the project to the newest standard version: update the Standard line in AGENTS.md after checking the CHANGELOG."
    },
    {
      "id": "C5",
      "title": "AGENTS.md has the UTF-8 rule",
      "severity": "optional",
      "since": "v1.1.0",
      "required_from": null,
      "kind": "contains",
      "path": "AGENTS.md",
      "pattern": "UTF-8 without a BOM",
      "fix": "Add the core rule 'Text files are UTF-8 without a BOM.' to AGENTS.md."
    },
    {
      "id": "C1",
      "title": "v1: AGENTS.md has the Doc status table",
      "severity": "optional",
      "since": "v1.0.0",
      "required_from": null,
      "kind": "contains",
      "path": "AGENTS.md",
      "pattern": "(?m)^## Doc status",
      "applies_if": { "path": "AGENTS.md", "pattern": "Template version: v\\d" },
      "fix": "v1 project: move it to v2 (/new-project, option 3) instead of fixing v1 checks."
    },
    {
      "id": "C3",
      "title": "v1: docs 00-16 all exist (stubs count)",
      "severity": "optional",
      "since": "v1.0.0",
      "required_from": null,
      "kind": "exists",
      "paths": [
        "docs/00-vision.md",
        "docs/01-requirements.md",
        "docs/02-architecture.md",
        "docs/03-tech-stack.md",
        "docs/04-project-plan.md",
        "docs/05-decisions-log.md",
        "docs/06-coding-conventions.md",
        "docs/07-testing-checklist.md",
        "docs/08-prompt-log.md",
        "docs/09-status-report.md",
        "docs/10-session-log.md",
        "docs/11-glossary.md",
        "docs/12-manual-tests.md",
        "docs/13-git-workflow.md",
        "docs/14-security.md",
        "docs/15-accessibility.md",
        "docs/16-budget.md"
      ],
      "applies_if": { "path": "AGENTS.md", "pattern": "Template version: v\\d" },
      "fix": "v1 project: move it to v2 (/new-project, option 3) instead of fixing v1 checks."
    },
    {
      "id": "C6",
      "title": "v1: AGENTS.md has a Template version line",
      "severity": "optional",
      "since": "v1.2.0",
      "required_from": null,
      "kind": "contains",
      "path": "AGENTS.md",
      "pattern": "Template version: v\\d",
      "applies_if": { "path": "AGENTS.md", "pattern": "Template version:" },
      "fix": "v1 project: move it to v2 (/new-project, option 3), which uses the Standard line instead."
    },
    {
      "id": "C7",
      "title": "v1: PR template present (GitHub-hosted projects)",
      "severity": "optional",
      "since": "v1.0.0",
      "required_from": null,
      "kind": "exists",
      "paths": [".github/pull_request_template.md"],
      "applies_if": { "path": "AGENTS.md", "pattern": "Template version: v\\d[\\s\\S]*\\*\\*Hosting: github\\*\\*" },
      "fix": "v1 project: move it to v2 (/new-project, option 3); v2 has no PR template."
    },
    {
      "id": "W1",
      "title": "CLAUDE.md loads AGENTS.md",
      "severity": "warning",
      "since": "v1.0.0",
      "required_from": null,
      "kind": "contains",
      "path": "CLAUDE.md",
      "if_exists": true,
      "pattern": "(?m)^\\s*@AGENTS\\.md\\s*$",
      "applies_if": { "path": "AGENTS.md", "pattern": "\\*\\*Standard:\\*\\*" },
      "fix": "Add '@AGENTS.md' as the first line of CLAUDE.md, or Claude Code never loads AGENTS.md."
    },
    {
      "id": "W3",
      "title": "docs/requirements.md has no unfilled placeholders",
      "severity": "warning",
      "since": "v2.0.0",
      "required_from": null,
      "kind": "absent",
      "paths": ["docs/requirements.md"],
      "pattern": "<[A-Za-z][^<>`\\r\\n]*\\s[^<>`\\r\\n]*>",
      "applies_if": { "path": "AGENTS.md", "pattern": "\\*\\*Standard:\\*\\*" },
      "fix": "Fill in the remaining <...> placeholders in docs/requirements.md: vision, phases, NFRs (/new-project drafts the vision; /breakdown the phases)."
    },
    {
      "id": "W4",
      "title": "No old copies of the standard's skills in .claude/skills",
      "severity": "warning",
      "since": "v2.0.0",
      "required_from": null,
      "kind": "absent",
      "paths": [
        ".claude/skills/a11y-check/SKILL.md",
        ".claude/skills/brainstorm/SKILL.md",
        ".claude/skills/breakdown/SKILL.md",
        ".claude/skills/decide/SKILL.md",
        ".claude/skills/fix-bug/SKILL.md",
        ".claude/skills/report/SKILL.md",
        ".claude/skills/security-check/SKILL.md",
        ".claude/skills/stack/SKILL.md",
        ".claude/skills/story/SKILL.md",
        ".claude/skills/wrap-up/SKILL.md"
      ],
      "pattern": "[\\s\\S]",
      "applies_if": { "path": "AGENTS.md", "pattern": "\\*\\*Standard:\\*\\*" },
      "fix": "Delete these v1 copies: they run instead of the installed skills (install-skills.ps1)."
    },
    {
      "id": "W2",
      "title": "v1: planning docs (00, 02-04) have no unfilled placeholders",
      "severity": "warning",
      "since": "v1.0.0",
      "required_from": null,
      "kind": "absent",
      "paths": [
        "docs/00-vision.md",
        "docs/02-architecture.md",
        "docs/03-tech-stack.md",
        "docs/04-project-plan.md"
      ],
      "pattern": "<[A-Za-z][^<>`\\r\\n]*\\s[^<>`\\r\\n]*>",
      "applies_if": { "path": "AGENTS.md", "pattern": "Template version: v\\d" },
      "fix": "v1 project: move it to v2 (/new-project, option 3)."
    }
  ]
}
